{
  "name": "ssrprompt",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ssrprompt/client dev",
    "dev:server": "pnpm --filter @ssrprompt/server dev",
    "dev:worker": "pnpm --filter @ssrprompt/server worker",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm --filter @ssrprompt/server dev\" \"pnpm --filter @ssrprompt/server worker\"",
    "build": "pnpm --filter @ssrprompt/client build",
    "build:shared": "pnpm --filter @ssrprompt/shared build",
    "build:server": "pnpm --filter @ssrprompt/server build",
    "build:all": "pnpm run build:shared && pnpm run build && pnpm run build:server",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ssrprompt/server prisma:generate",
    "db:push": "pnpm --filter @ssrprompt/server prisma:push",
    "db:migrate": "pnpm --filter @ssrprompt/server prisma:migrate",
    "db:deploy": "pnpm --filter @ssrprompt/server prisma:migrate:deploy",
    "db:deploy:target": "pnpm --filter @ssrprompt/server prisma:migrate:target",
    "db:deploy:target:resolve": "pnpm --filter @ssrprompt/server prisma:migrate:target:resolve",
    "db:studio": "pnpm --filter @ssrprompt/server prisma:studio",
    "db:prepare:prod": "pnpm db:deploy && pnpm --filter @ssrprompt/server worker:setup"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
