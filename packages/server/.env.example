# ------------------------------
# SSRPrompt Server Environment
# Copy this file to packages/server/.env
# ------------------------------

# [Server]
# Runtime mode: development | production | test
NODE_ENV=development
# HTTP port for API service
PORT=3001

# [Database]
# PostgreSQL DSN
DATABASE_URL=postgresql://postgres:password@localhost:5432/ssrprompt?schema=public
# Graphile Worker schema name in PostgreSQL (identifier only)
GRAPHILE_WORKER_SCHEMA=graphile_worker

# [Auth & Security]
# JWT signing secret (minimum 32 chars)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
# AES-256-GCM key in hex (64 chars = 32 bytes)
ENCRYPTION_KEY=your-64-character-hex-string-for-aes-256-encryption
# Generate ENCRYPTION_KEY:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# [CORS]
# Comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# [Rate Limit]
# Global API window size (ms)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window
RATE_LIMIT_MAX_REQUESTS=300

# [Registration & Bootstrap]
# Allow new user registration
ALLOW_REGISTRATION=true
# Require email code when registering
REQUIRE_EMAIL_VERIFICATION=false
# Seed default role/permissions and admin user on startup
AUTO_SEED_ON_STARTUP=true

# Admin account used by startup auto-seed and manual seed command
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# [Storage - S3 compatible]
# Required for file upload/attachments/OCR input files
S3_ENDPOINT=https://jpminio.zeabur.app
S3_BUCKET=zeabur
S3_ACCESS_KEY_ID=your-minio-access-key
S3_SECRET_ACCESS_KEY=your-minio-secret-key
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# [Evaluation Queue]
# Queue backend: pg (default, recommended) | memory (dev/light only)
EVALUATION_QUEUE_DRIVER=pg
# Max concurrent runs per process
EVALUATION_RUN_CONCURRENCY=5
# Max concurrent test cases within one run
EVALUATION_CASE_CONCURRENCY=5
# Batch size for persisting run results
EVALUATION_RESULT_BATCH_SIZE=20
# Abort signal check interval in runner loop (ms)
EVALUATION_ABORT_CHECK_INTERVAL_MS=2000
# Worker polling interval for Graphile Worker (ms)
EVALUATION_WORKER_POLL_INTERVAL_MS=1000
# Run progress update throttle interval (ms)
EVALUATION_PROGRESS_UPDATE_INTERVAL_MS=1000
# Run progress update batch threshold
EVALUATION_PROGRESS_UPDATE_BATCH_SIZE=1

# [Queue Recovery Daemon]
# Re-enqueue stale pending jobs when using pg queue
EVALUATION_QUEUE_RECOVERY_ENABLED=true
EVALUATION_QUEUE_RECOVERY_INTERVAL_MS=15000
EVALUATION_QUEUE_RECOVERY_MIN_PENDING_AGE_MS=20000
EVALUATION_QUEUE_RECOVERY_RUN_BATCH_SIZE=50
EVALUATION_QUEUE_RECOVERY_IMPORT_BATCH_SIZE=20

# [Evaluation Import Limits]
EVALUATION_IMPORT_CONCURRENCY=4
EVALUATION_IMPORT_MAX_ZIP_BYTES=52428800
EVALUATION_IMPORT_MAX_ZIP_ENTRIES=5000
EVALUATION_IMPORT_MAX_ZIP_UNCOMPRESSED_BYTES=209715200
EVALUATION_IMPORT_MAX_ATTACHMENT_BYTES=20971520
EVALUATION_IMPORT_MAX_ERRORS=100
EVALUATION_IMPORT_URL_TIMEOUT_MS=20000
EVALUATION_IMPORT_URL_MAX_REDIRECTS=3

# [Chat / Files Guardrails]
# Max bytes for inline chat attachments download
CHAT_ATTACHMENT_MAX_BYTES=20971520
# Max bytes when reading stored files into memory
FILES_BUFFER_DOWNLOAD_MAX_BYTES=52428800
# Max bytes for evaluation attachment processing
EVALUATION_ATTACHMENT_MAX_BYTES=20971520

# [SMTP]
# Required when REQUIRE_EMAIL_VERIFICATION=true or password reset email is used
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="SSRPrompt <noreply@example.com>"

# [OAuth]
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/google/callback

OAUTH_LINUXDO_ENABLED=false
OAUTH_LINUXDO_CLIENT_ID=
OAUTH_LINUXDO_CLIENT_SECRET=
OAUTH_LINUXDO_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/linuxdo/callback
